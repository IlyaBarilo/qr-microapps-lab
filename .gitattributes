* text=auto eol=crlf

# Unix shell scripts require LF for portable shebang handling.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
